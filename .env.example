# Anthropic API Configuration
ANTHROPIC_API_KEY=
# Recommended: Model selection (default: claude-opus-5)
# Recommended: claude-opus-5, claude-sonnet-5, claude-haiku-4-5-20251001
AGENT_MODEL=claude-opus-5

# Optional: Logging level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# Optional: Max retries for API calls
MAX_RETRIES=3

# Optional: Request timeout in seconds
REQUEST_TIMEOUT=30
